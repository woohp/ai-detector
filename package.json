{
  "name": "ai-detector",
  "description": "Browser extension that scores selected text as human vs AI-generated with a local ONNX model",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bundle:chrome": "node scripts/bundle.mjs chrome",
    "bundle:firefox": "node scripts/bundle.mjs firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "npm run zip:chrome && npm run zip:firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "export:vanguard": "python model/export.py vanguard",
    "export:tabularis": "python model/export.py tabularis"
  },
  "devDependencies": {
    "@wxt-dev/auto-icons": "^1.1.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0"
  }
}
